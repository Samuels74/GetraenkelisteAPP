# Settings for docker compose – copy to .env (next to compose.yaml) and adjust.
# .env is gitignored; it may contain secrets. Compose replaces `$NAME` in values,
# also inside double quotes: put a value that contains `$` in single quotes
# ('...') – or simply avoid `$` in passwords.

# Where the app's plain-HTTP port is published on the server:
#   127.0.0.1  only the server itself – reverse proxy installed on the host (default)
#   0.0.0.0    all interfaces – reverse proxy on another machine; firewall the port!
#              Note: ports published by Docker bypass ufw/firewalld INPUT rules –
#              restrict them in the DOCKER-USER chain.
# Reverse proxy running in Docker? Use the proxy's network instead of a published
# port – see deploy/reverse-proxy.md.
GETRAENKELISTE_BIND=127.0.0.1
GETRAENKELISTE_PORT=8090

# Optional: superuser for the PocketBase dashboard (/_/) – created or updated at
# every start while both are set (password: at least 8 characters, use a long one).
# A changed e-mail adds a second superuser – delete the old one (README, "Operation").
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# Optional: exactly 32 characters, e.g. from `openssl rand -hex 16` – encrypts the
# stored app settings. Set it before the first start and never change or remove it
# afterwards: the data volume and its backups only start with this key – keep a
# copy of it with your off-site backups.
PB_ENCRYPTION_KEY=
