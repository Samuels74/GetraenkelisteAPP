# Podman Quadlet unit: runs Getränkeliste as a systemd *user* service.
# Requires Podman ≥ 5.0 (`Notify=healthy` below); with Podman 4.x remove that
# line – the service then counts as started as soon as the container runs.
#
# Install (as the user that owns the image, e.g. after `make build`):
#   mkdir -p ~/.config/containers/systemd
#   cp deploy/getraenkeliste.container ~/.config/containers/systemd/
#   systemctl --user daemon-reload
#   systemctl --user start getraenkeliste.service
#   loginctl enable-linger "$USER"      # keep it running without a login session
#
# Status / logs:   systemctl --user status getraenkeliste
#                  journalctl --user -u getraenkeliste -f
# New image:       make build && systemctl --user restart getraenkeliste
#                  (or `podman auto-update`, see AutoUpdate below)
#
# Use either this service or `make run` – both use the container name
# "getraenkeliste" and the volume "getraenkeliste-data" (same data).
#
# Backups: PocketBase writes daily backups (03:00 UTC, latest 14 kept) into the
# volume (pb_data/backups); download them via the dashboard (Settings → Backups).
# Cold volume export: stop the service first with
#   systemctl --user stop getraenkeliste
# (not `podman stop` – Restart=always would start it again right away), then
#   podman volume export getraenkeliste-data -o getraenkeliste-backup.tar
#   systemctl --user start getraenkeliste
# Restore: README.md, "Operation". With PB_ENCRYPTION_KEY set, the volume and its
# backups only start with that same key – keep it with the off-site backups.

[Unit]
Description=Getränkeliste (PocketBase + web app)
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=getraenkeliste
Image=localhost/getraenkeliste:latest
# Named volume with the database, uploaded files and backups.
Volume=getraenkeliste-data:/pb_data
# Plain HTTP for the reverse proxy on this host, which terminates TLS
# (deploy/reverse-proxy.md; a proxy in a container: see there). Only for a
# proxy on another machine publish on all interfaces instead – and firewall the
# port, nothing but the proxy may reach it:
#PublishPort=8090:8090
PublishPort=127.0.0.1:8090:8090
# Hardened like compose.yaml: read-only root filesystem (Podman mounts a tmpfs
# on /tmp), no Linux capabilities, no privilege escalation.
ReadOnly=true
DropCapability=all
NoNewPrivileges=true
# Optional: superuser for the PocketBase dashboard (/_/), upserted at start
# (a changed e-mail adds a superuser – README.md, "Operation"), and a key of
# exactly 32 characters that encrypts the stored settings (`openssl rand -hex 16`).
# Put secrets into an env file (chmod 600) instead of this unit – one VAR=value
# per line, without quotes (Podman keeps quotes as part of the value):
#   PB_SUPERUSER_EMAIL=ops@example.com
#   PB_SUPERUSER_PASSWORD=...
#   PB_ENCRYPTION_KEY=...
#EnvironmentFile=%h/.config/getraenkeliste.env
# The service becomes "started" once the image HEALTHCHECK (/api/health) passes.
Notify=healthy
# `podman auto-update` restarts the service when localhost/getraenkeliste:latest changed.
AutoUpdate=local

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
